# Damru Service Environment Variables

# Flask Configuration
FLASK_ENV=production
FLASK_PORT=5000
LOG_LEVEL=INFO

# Redroid/ADB Connection
REDROID_HOST=damru-redroid
REDROID_PORT=5555

# Damru Pool Settings
NUM_DEVICES=2
REDROID_CPUS=2.0
REDROID_MEMORY=2g

# Chrome APK Path (optional - auto-detected from baked image)
# CHROME_APK=/home/damru/chrome-apks/145.0.7632.75

# API Worker Settings
MAX_WORKERS=5
WORKER_TIMEOUT=120
